{
  "name": "liquid-glass",
  "private": true,
  "version": "0.1.0",
  "description": "A React and Tailwind CSS design system with glass on peripheral layers and solid surfaces for data.",
  "license": "MIT",
  "author": "walrvca",
  "homepage": "https://walrvca.github.io/liquid-glass/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walrvca/liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/walrvca/liquid-glass/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "radix-ui",
    "accessibility",
    "glassmorphism"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
